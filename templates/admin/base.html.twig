{% extends "base.html.twig" %}

{% block body %}
<div class="admin-shell">

    <header class="admin-shell__topbar">

        <a
            class="admin-shell__brand"
            href="{{ path("app_admin_dashboard") }}"
        >
            🐾 Pet <strong>Concierge</strong>
        </a>

        <div class="admin-shell__account">
            <div class="admin-shell__identity">
                <strong>{{ app.user.nombreCompleto }}</strong>
                <span>Administrador</span>
            </div>

            <form
                action="{{ path("app_salir") }}"
                method="post"
            >
                <input
                    type="hidden"
                    name="_csrf_token"
                    value="{{ csrf_token("logout") }}"
                >

                <button
                    class="admin-shell__logout"
                    type="submit"
                >
                    Cerrar sesión
                </button>
            </form>
        </div>

    </header>

    <div class="admin-shell__body">

        <aside class="admin-shell__sidebar">

            <div class="admin-nav">

                <span class="admin-nav__heading">
                    GENERAL
                </span>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_dashboard" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_dashboard") }}"
                >
                    <span>📊</span> Dashboard
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_usuarios" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_usuarios") }}"
                >
                    <span>👥</span> Usuarios
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_perros" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_perros") }}"
                >
                    <span>🐶</span> Perros
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_planes" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_planes") }}"
                >
                    <span>🌿</span> Planes
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_suscripciones" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_suscripciones") }}"
                >
                    <span>📋</span> Suscripciones
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_paseos" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_paseos") }}"
                >
                    <span>🐕</span> Paseos
                </a>

                <span class="admin-nav__heading">
                    CORE ANALÍTICO
                </span>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_reportes" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_reportes") }}"
                >
                    <span>📈</span> Reportes
                </a>

                <a
                    class="admin-nav__item {% if app.request.attributes.get("_route") == "app_admin_riesgos" %}admin-nav__item--active{% endif %}"
                    href="{{ path("app_admin_riesgos") }}"
                >
                    <span>⚠️</span> Riesgos
                </a>

            </div>

            <div class="admin-shell__sidebar-note">
                🌱 Gestión inteligente y bienestar animal
            </div>

        </aside>

        <main class="admin-shell__main">
            {% block admin_content %}{% endblock %}
        </main>

    </div>

</div>
{% endblock %}
