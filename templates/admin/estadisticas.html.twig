{% extends "admin/base.html.twig" %}

{% block title %}
    Dashboard administrativo | Pet Concierge
{% endblock %}

{% block admin_content %}

<section class="admin-dashboard__welcome">

    <div class="admin-dashboard__welcome-copy">

        <span class="admin-dashboard__eyebrow">
            PANEL DE CONTROL
        </span>

        <h1>
            Bienvenido,
            {{ app.user.nombre }}
            👋
        </h1>

        <p>
            Administra Pet Concierge y consulta
            la información que alimenta
            nuestro Core estadístico.
        </p>

        <span class="admin-dashboard__welcome-tag">
            ● Sistema administrativo activo
        </span>

    </div>

    {% if imagen_estadisticas %}
        <img
            class="admin-dashboard__mascot"
            src="{{ asset(imagen_estadisticas) }}"
            alt="Bluey presentando estadísticas"
        >
    {% else %}
        <span class="admin-dashboard__mascot-fallback">
            🐶
        </span>
    {% endif %}

</section>

<div class="admin-dashboard__section-heading">
    <h2>Resumen general</h2>
    <span>Datos actuales de SQLite</span>
</div>

<section class="admin-dashboard__stats">

    <article class="admin-stat">
        <span class="admin-stat__icon">
            👥
        </span>

        <span class="admin-stat__label">
            Usuarios totales
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.usuarios.total }}
        </strong>

        <span class="admin-stat__detail">
            Cuentas registradas
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            🐶
        </span>

        <span class="admin-stat__label">
            Clientes
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.usuarios.clientes }}
        </strong>

        <span class="admin-stat__detail">
            {{ dashboard.usuarios.porcentajeClientes }} %
            del total
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            🐾
        </span>

        <span class="admin-stat__label">
            Paseadores
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.usuarios.paseadores }}
        </strong>

        <span class="admin-stat__detail">
            {{ dashboard.usuarios.porcentajePaseadores }} %
            del total
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            🐕
        </span>

        <span class="admin-stat__label">
            Perros registrados
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.general.totalPerros }}
        </strong>

        <span class="admin-stat__detail">
            Mascotas en el sistema
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            📋
        </span>

        <span class="admin-stat__label">
            Clientes con plan activo
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.financiero.clientesSuscritos }}
        </strong>

        <span class="admin-stat__detail">
            {{ dashboard.financiero.porcentajeSuscritos }} % de clientes
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            📅
        </span>

        <span class="admin-stat__label">
            Suscripciones activas
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.general.suscripcionesActivas }}
        </strong>

        <span class="admin-stat__detail">
            Planes vigentes
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            📅
        </span>

        <span class="admin-stat__label">
            Paseos programados
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.operativo.programados }}
        </strong>

        <span class="admin-stat__detail">
            Pendientes de realizar
        </span>
    </article>

    <article class="admin-stat">
        <span class="admin-stat__icon">
            ✅
        </span>

        <span class="admin-stat__label">
            Paseos completados
        </span>

        <strong class="admin-stat__value">
            {{ dashboard.operativo.completados }}
        </strong>

        <span class="admin-stat__detail">
            Finalizados correctamente
        </span>
    </article>

</section>

<div class="admin-dashboard__section-heading">
    <h2>Estadísticas financieras</h2>
    <span>Valores calculados desde SQLite</span>
</div>

<section class="admin-dashboard__analytics">

    <article class="admin-panel">

        <h3 class="admin-panel__title">
            Valor total de suscripciones
        </h3>

        <p class="admin-panel__subtitle">
            Suma de precios de todos los planes asignados (tarifas demo)
        </p>

        <div class="admin-pending">
            <div class="admin-pending__row">
                <span>Valor total registrado</span>
                <strong>${{ dashboard.financiero.valorTotal|number_format(2, ".", ",") }} USD</strong>
            </div>

            <div class="admin-pending__row">
                <span>Plan más utilizado</span>
                <strong>{{ dashboard.financiero.planMasUtilizado }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>Clientes suscritos</span>
                <strong>{{ dashboard.financiero.clientesSuscritos }} de {{ dashboard.usuarios.clientes }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>% clientes con plan</span>
                <strong>{{ dashboard.financiero.porcentajeSuscritos }}%</strong>
            </div>
        </div>

        <p class="admin-panel__hint">
            Los valores corresponden a tarifas de demostración. No representan ingresos cobrados.
        </p>

    </article>

    <article class="admin-panel">

        <h3 class="admin-panel__title">
            Distribución de suscripciones
        </h3>

        <p class="admin-panel__subtitle">
            Porcentaje por plan entre los clientes suscritos
        </p>

        <div class="admin-bars">
            {% for plan, count in dashboard.financiero.planesDistribucion ?? {} %}
            <div class="admin-bars__item">
                <div class="admin-bars__label">
                    <span>{{ plan }}</span>
                    <strong>{{ count }} ({{ dashboard.usuarios.clientes > 0 ? (count * 100 / dashboard.usuarios.clientes)|round(1) : 0 }}%)</strong>
                </div>

                <div class="admin-bars__track">
                    <div
                        class="admin-bars__fill"
                        style="width: {{ dashboard.usuarios.clientes > 0 ? (count * 100 / dashboard.usuarios.clientes) : 0 }}%"
                    ></div>
                </div>
            </div>
            {% else %}
            <div class="admin-pending">
                <div class="admin-pending__row">
                    <span>Sin datos de distribución</span>
                    <strong>—</strong>
                </div>
            </div>
            {% endfor %}
        </div>

    </article>

</section>

<div class="admin-dashboard__section-heading">
    <h2>Estadísticas operativas</h2>
    <span>Actividad de paseos y paseadores</span>
</div>

<section class="admin-dashboard__analytics">

    <article class="admin-panel">

        <h3 class="admin-panel__title">
            Paseos por estado
        </h3>

        <p class="admin-panel__subtitle">
            Distribución del total de paseos registrados
        </p>

        <div class="admin-pending">
            <div class="admin-pending__row">
                <span>Total</span>
                <strong>{{ dashboard.operativo.totalPaseos }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>Programados</span>
                <strong>{{ dashboard.operativo.programados }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>En curso</span>
                <strong>{{ dashboard.operativo.en_curso ?? 0 }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>Completados</span>
                <strong>{{ dashboard.operativo.completados }}</strong>
            </div>

            <div class="admin-pending__row">
                <span>Cancelados</span>
                <strong>{{ dashboard.operativo.cancelados }}</strong>
            </div>
        </div>

    </article>

    <article class="admin-panel">

        <h3 class="admin-panel__title">
            Carga de trabajo por paseador
        </h3>

        <p class="admin-panel__subtitle">
            Cantidad de paseos asignados a cada paseador
        </p>

        {% if dashboard.operativo.cargaPaseadores|length > 0 %}
            <div class="admin-bars">
                {% for paseador, total in dashboard.operativo.cargaPaseadores %}
                <div class="admin-bars__item">
                    <div class="admin-bars__label">
                        <span>{{ paseador }}</span>
                        <strong>{{ total }} paseos</strong>
                    </div>

                    <div class="admin-bars__track">
                        <div
                            class="admin-bars__fill admin-bars__fill--walkers"
                            style="width: {{ dashboard.operativo.totalPaseos > 0 ? (total * 100 / dashboard.operativo.totalPaseos) : 0 }}%"
                        ></div>
                    </div>
                </div>
                {% endfor %}
            </div>
        {% else %}
            <p>No hay paseadores con paseos asignados.</p>
        {% endif %}

    </article>

</section>

<div class="admin-dashboard__section-heading">
    <h2>Gestión rápida</h2>
    <span>Administración MVC</span>
</div>

<section class="admin-dashboard__bottom">

    <article class="admin-panel">
        <div class="admin-panel__header">
            <div>
                <h3 class="admin-panel__title">
                    Usuarios recientes
                </h3>

                <p class="admin-panel__subtitle">
                    Últimas cuentas registradas
                </p>
            </div>

            <a
                class="admin-panel__link"
                href="{{ path("app_admin_usuarios") }}"
            >
                Ver todos
            </a>
        </div>

        <div class="admin-recent">

            {% for usuario in dashboard.usuarios.ultimosUsuarios %}

                <div class="admin-recent__item">
                    <div class="admin-recent__avatar">
                        {{ usuario.nombre|slice(0, 1)|upper }}
                    </div>

                    <div class="admin-recent__identity">
                        <strong>
                            {{ usuario.nombreCompleto }}
                        </strong>

                        <small>
                            {{ usuario.email }}
                        </small>
                    </div>

                    <span class="admin-recent__role">
                        {% if "ROLE_ADMIN" in usuario.roles %}
                            Admin
                        {% elseif "ROLE_PASEADOR" in usuario.roles %}
                            Paseador
                        {% else %}
                            Cliente
                        {% endif %}
                    </span>
                </div>

            {% else %}

                <p>
                    Aún no hay usuarios registrados.
                </p>

            {% endfor %}

        </div>

    </article>

    <article class="admin-panel admin-panel--actions">

        <h3 class="admin-panel__title">
            Accesos rápidos
        </h3>

        <p class="admin-panel__subtitle">
            Accede a las herramientas disponibles.
        </p>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_usuarios") }}"
        >
            <span>👥 Gestión de usuarios</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_perros") }}"
        >
            <span>🐶 Gestión de perros</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_planes") }}"
        >
            <span>🌿 Planes prepagados</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_suscripciones") }}"
        >
            <span>📋 Suscripciones</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_paseos") }}"
        >
            <span>🐕 Paseos</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_reportes") }}"
        >
            <span>📊 Reportes financieros</span>
            <span>→</span>
        </a>

        <a
            class="admin-quick-link"
            href="{{ path("app_admin_riesgos") }}"
        >
            <span>⚠️ Análisis de riesgos</span>
            <span>→</span>
        </a>

    </article>

</section>

{% endblock %}
