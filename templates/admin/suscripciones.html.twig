{% extends 'admin/base.html.twig' %}
{% block title %}Suscripciones | Pet Concierge{% endblock %}
{% block admin_content %}
<div class="pet-module">
  <a class="pet-module__back" href="{{ path('app_admin_dashboard') }}">← Dashboard</a>
  <header class="pet-module__heading"><div><span class="pet-module__eyebrow">ADMINISTRACIÓN MVC</span><h1>📋 Suscripciones</h1><p>Planes contratados por los clientes.</p></div></header>
  {% for mensaje in app.flashes('success') %}<p class="admin-user-alert" role="status">✓ {{ mensaje }}</p>{% endfor %}
  <section class="pet-module__card">
    <p><a class="pet-module__button" href="{{ path('app_admin_suscripcion_nueva') }}">+ Nueva suscripción</a></p>
    <div class="users-admin__table-wrapper"><table class="users-admin__table"><thead><tr><th>ID</th><th>Cliente</th><th>Plan</th><th>Inicio</th><th>Fin</th><th>Estado</th><th>Opciones</th></tr></thead><tbody>
    {% for s in suscripciones %}<tr><td>#{{ s.id }}</td><td>{{ s.usuario ? s.usuario.nombreCompleto : 'Sin cliente' }}</td><td>{{ s.plan ? s.plan.nombre : 'Sin plan' }}</td><td>{{ s.fechaInicio ? s.fechaInicio|date('d/m/Y') : '—' }}</td><td>{{ s.fechaFin ? s.fechaFin|date('d/m/Y') : '—' }}</td><td>{{ s.estado }}</td><td><a href="{{ path('app_admin_suscripcion_ver', {id: s.id}) }}">Ver</a> · <a href="{{ path('app_admin_suscripcion_editar', {id: s.id}) }}">Editar</a></td></tr>
    {% else %}<tr><td colspan="7">No hay suscripciones registradas.</td></tr>{% endfor %}
    </tbody></table></div>
  </section>
</div>
{% endblock %}
