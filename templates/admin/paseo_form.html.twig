{% extends 'admin/base.html.twig' %}
{% block title %}{{ es_nuevo ? 'Nuevo paseo' : 'Editar paseo' }} | Pet Concierge{% endblock %}
{% block admin_content %}
<div class="pet-module pet-module--narrow"><a class="pet-module__back" href="{{ path('app_admin_paseos') }}">← Volver a paseos</a>
<header class="pet-module__heading"><div><span class="pet-module__eyebrow">ADMINISTRACIÓN MVC</span><h1>{{ es_nuevo ? 'Registrar paseo' : 'Editar paseo' }}</h1><p>Selecciona un cliente; el dropdown de perros mostrará solo sus mascotas.</p></div></header>
<section class="pet-module__card">
  {{ form_start(formulario, {attr: {class: 'pet-module__form'}}) }}
  {{ form_errors(formulario) }}
  <div class="pet-module__form-grid">
  {% for campo in formulario %}{% if campo.vars.name != '_token' %}<div class="pet-module__field">{{ form_label(campo) }}{{ form_widget(campo) }}{{ form_errors(campo) }}</div>{% endif %}{% endfor %}
  </div>
  <div class="pet-module__form-actions"><a class="pet-module__secondary" href="{{ path('app_admin_paseos') }}">Cancelar</a><button class="pet-module__button" type="submit">{{ es_nuevo ? 'Guardar paseo' : 'Guardar cambios' }}</button></div>
  {{ form_end(formulario) }}
</section></div>
<script>
(function () {
  const cliente = document.getElementById('{{ formulario.cliente.vars.id }}');
  const perro = document.getElementById('{{ formulario.perro.vars.id }}');
  const urlBase = {{ path('app_admin_paseos_perros_por_cliente', {clienteId: 999999})|json_encode|raw }};
  if (!cliente || !perro) return;
  const elegido = '{{ (es_nuevo ? '' : (paseo.perro ? paseo.perro.id : '')) }}';
  async function actualizar() {
    const id = cliente.value;
    perro.disabled = true;
    perro.replaceChildren(new Option(id ? 'Cargando mascotas...' : 'Primero selecciona un cliente', ''));
    if (!id) return;
    try {
      const respuesta = await fetch(urlBase.replace('999999', encodeURIComponent(id)), {credentials: 'same-origin'});
      if (!respuesta.ok) throw new Error('No se pudieron consultar los perros');
      const perros = await respuesta.json();
      perro.replaceChildren(new Option('Selecciona un perro', ''));
      perros.forEach(p => perro.add(new Option(p.nombre + ' (' + p.raza + ')', String(p.id))));
      if (elegido && Array.from(perro.options).some(p => p.value === elegido)) perro.value = elegido;
      perro.disabled = false;
    } catch (error) {
      perro.replaceChildren(new Option('Error al cargar mascotas', ''));
      console.error(error);
    }
  }
  cliente.addEventListener('change', actualizar);
  if (cliente.value) actualizar();
})();
</script>
{% endblock %}
